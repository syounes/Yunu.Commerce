{
  "ConnectionStrings": {
    "VectorStore": ""
  },
  "Catalog": {
    "Mongo": {
      "ConnectionString": "",
      "DatabaseName": "yunu_catalog"
    },
    "GoogleTaxonomy": {
      "SourceUrl": "https://www.google.com/basepages/producttype/taxonomy-with-ids.en-US.txt",
      "Language": "en-US"
    },
    "GoogleTaxonomySql": {
      "ConnectionString": ""
    },
    "GoogleTaxonomyEmbeddings": {
      "BatchSize": 50,
      "MaxDegreeOfParallelism": 4
    },
    "AttributeEmbeddings": {
      "BatchSize": 50,
      "MaxDegreeOfParallelism": 4,
      "Locale": "pt-BR"
    }
  },
  "AI": {
    "Embeddings": {
      "DefaultProvider": "azure"
    },
    "Connections": {
      "AzureOpenAI": {
        "Endpoint": "https://aif-yunu-commerce-lab.openai.azure.com/openai/v1/"
      }
    },
    "Models": {
      "CategoryEmbedding": {
        "Connection": "AzureOpenAI",
        "DeploymentName": "yunu-embedding-category-v1",
        "ModelType": "Embedding",
        "Dimensions": 1536
      },
      "IntentRewriter": {
        "Connection": "AzureOpenAI",
        "DeploymentName": "yunu-intent-rewriter-v1",
        "ModelType": "Chat"
      },
      "CatalogReranker": {
        "Connection": "AzureOpenAI",
        "DeploymentName": "yunu-intent-rewriter-v1",
        "ModelType": "Chat"
      }
    },
    "AttributeResolution": {
      "EmbeddingModel": "CategoryEmbedding",
      "TopK": 5,
      "DefinitionMinimumSimilarity": 0.50,
      "OptionMinimumSimilarity": 0.65,
      "MinimumScoreMargin": 0.05,
      "IncludeCandidatesInResponse": true
    },
    "CategoryResolution": {
      "EmbeddingModel": "CategoryEmbedding",
      "TopK": 20,
      "MinimumSimilarity": 0.70,
      "MinimumScoreMargin": 0.03,
      "IncludeCandidatesInResponse": true
    },
    "Reranking": {
      "Model": "CatalogReranker",
      "MinimumConfidence": 0.75,
      "MinimumScoreMargin": 0.10,
      "MaximumCandidates": 10,
      "AlwaysRerankSemanticMatches": true,
      "MaxConcurrentRerankRequests": 4,
      "TechnicalFailureFallback": "VectorThreshold"
    }
  }
}
